# 우리 백엔드(Render) 프록시 — 예시. 실제 값은 Render 대시보드에 넣는다.
PORT=8765
HOST=0.0.0.0
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
AUTH_REQUIRED=true
# 비우면 로그인한 모든 계정. 예: @donga.com,tester@example.com
ALLOWED_EMAILS=
RATE_LIMIT_PER_MIN=120
# 시험용 업스트림 대체(기본값은 실제 서비스)
# OPENAI_BASE_URL=https://api.openai.com/v1
# UNSPLASH_BASE_URL=https://api.unsplash.com
# 실제 CMS 송고(서버에서만 보관)
CMS_PUBLISH_URL=
CMS_BEARER_TOKEN=
# 송고할 수 있는 계정. 비우면 아무도 송고할 수 없다
CMS_ALLOWED_EMAILS=
