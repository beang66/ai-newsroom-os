# NAVER CLOVA Speech 설정
# CLOVA Speech 빌더 > 설정 > 연동 정보에서 확인한 Secret Key 입력
CLOVA_SPEECH_SECRET_KEY=

# CLOVA Speech 빌더 > 설정 > 연동 정보에서 확인한 Invoke URL 입력 (예: https://clovaspeech-gw.ncloud.com/external/v1/...)
CLOVA_SPEECH_INVOKE_URL=

# 백엔드 서버 포트
PORT=4000

# OpenAI API Key (AI 인터뷰 분석용)
OPENAI_API_KEY=
