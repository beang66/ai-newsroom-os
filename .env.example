# ==========================================
# AI Newsroom OS App Core 설정
# ==========================================
# Local UI review: demo. Core integration / production: api.
VITE_DATA_MAP_MODE=demo
# Real workspace ID must come from App Core session/article context in integration.
VITE_WORKSPACE_ID=
# Empty uses same-origin /v1 (Vite forwards to localhost:3001 in development).
VITE_CORE_BASE_URL=

# ==========================================
# NAVER CLOVA Speech STT 모듈 설정
# ==========================================
# CLOVA Speech 빌더 > 설정 > 연동 정보에서 확인한 Secret Key 입력
CLOVA_SPEECH_SECRET_KEY=

# CLOVA Speech 빌더 > 설정 > 연동 정보에서 확인한 Invoke URL 입력 (예: https://clovaspeech-gw.ncloud.com/external/v1/...)
CLOVA_SPEECH_INVOKE_URL=

# STT 백엔드 서버 포트
PORT=4000

# OpenAI API Key (AI 인터뷰 분석용)
OPENAI_API_KEY=
