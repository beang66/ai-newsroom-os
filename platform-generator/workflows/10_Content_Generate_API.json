      "name": "Receive Content Request",
      "webhookId": "d0307b25-62ae-4668-adb2-da52dcc5e95c"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body || $json;\n\nconst article = input.article || {};\n\nconst selectedKeywords = Array.isArray(input.selected_keywords)\n  ? input.selected_keywords\n  : [];\n\nconst platforms = Array.isArray(input.platforms)\n  ? input.platforms\n  : [];\n\nreturn [\n  {\n    json: {\n      article_id: article.article_id || '',\n      title: article.title || '',\n      content: article.content || '',\n\n      selected_keywords: selectedKeywords,\n\n      requirements: input.requirements || '',\n\n      platforms: platforms\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -176,
        -96
      ],
      "id": "74e7e1e5-f7ab-4a89-89ea-d0746e5158ff",
      "name": "Normalize Request"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst errors = [];\n\nif (!data.article_id) {\n  errors.push('article_id가 없습니다.');\n}\n\nif (!data.title) {\n  errors.push('기사 title이 없습니다.');\n}\n\nif (!data.content) {\n  errors.push('기사 content가 없습니다.');\n}\n\nif (!Array.isArray(data.platforms) || data.platforms.length === 0) {\n  errors.push('선택된 플랫폼이 없습니다.');\n}\n\nconst allowedPlatforms = [\n  'instagram',\n  'threads',\n  'blog'\n];\n\nconst invalidPlatforms = data.platforms.filter(\n  platform => !allowedPlatforms.includes(platform)\n);\n\nif (invalidPlatforms.length > 0) {\n  errors.push(\n    `지원하지 않는 플랫폼: ${invalidPlatforms.join(', ')}`\n  );\n}\n\nif (errors.length > 0) {\n  throw new Error(errors.join(' / '));\n}\n\nreturn [\n  {\n    json: data\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -96
      ],
      "id": "0510fe2f-e033-45c2-801b-271eb5ec6403",
      "name": "Validate Request"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nreturn data.platforms.map(platform => ({\n  json: {\n    article_id: data.article_id,\n    title: data.title,\n    content: data.content,\n\n    selected_keywords: data.selected_keywords,\n    requirements: data.requirements,\n\n    platform: platform\n  }\n}));"
      },
