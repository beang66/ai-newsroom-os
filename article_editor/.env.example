# 앱(코어)이 읽는 키 — 실제 값은 **워크스페이스 최상단 `.env`** 에 넣는다(gitignore).
# 이 파일은 이름·형식 예시일 뿐이고, 이름이 `.env` 가 아니면 읽지 않는다.
# 가까운 폴더의 .env 가 우선하고, OS 환경변수가 어떤 .env 보다 우선한다(app_paths.py).
#
# ★ 새 PC·배포본에서는 **`.env` 없이도 동작한다** — 공개 기본값이 앱에 심겨 있다(`app/core/defaults.py`:
#   SUPABASE_URL·SUPABASE_ANON_KEY·AI_BACKEND_URL). 비밀값은 백엔드에만 있으므로 여기서 채울 게 없다.
#   아래 값을 `.env` 에 넣는 경우는 **로컬 키로 직접 개발할 때(AI_BACKEND=local)** 뿐이다.

# ── 실행
PORT=8765                        # 창 모드 코어 서버 포트

# ── AI 경로
# local  = 로컬 .env 키(OPENAI_API_KEY)로 외부 API 직접 — 개발 전용
# remote = 우리 백엔드(Render) 프록시 — 배포본 기본. 앱에 운영키를 두지 않는다
AI_BACKEND=local
AI_BACKEND_URL=                  # remote 일 때: https://<서비스>.onrender.com
APP_TOKEN=                       # 로그인(세션) 붙기 전 임시 토큰(선택). 로그인 토큰이 우선
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Supabase (Auth / Postgres) — 앱은 anon 키만. service_role 키는 금지(백엔드 전용)
SUPABASE_URL=                    # https://<ref>.supabase.co  (postgresql:// 접속 문자열 금지)
SUPABASE_ANON_KEY=

# ── 로컬 모델 (docs/LOCAL_MODELS.md) — 기본은 설치 폴더 안
# MODELS_DIR=                    # 기본 <설치폴더>/models
# HF_HOME=                       # 기본 <설치폴더>/models/hf
USE_LOCAL_MODELS=false           # true 면 제목·부제를 로컬 모델로(requirements-headline.txt 필요)
HEADLINE_MODEL=onebeans/keT5-news-title-gen
SUBTITLE_MODEL=gogamza/kobart-summarization

# ── 개발 전용 키 — AI_BACKEND=local 일 때만 쓴다. 배포본에는 넣지 않는다
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=
FLOW_SUMMARY_PROVIDER=openai     # 또는 kobart(로컬)

# ── 진단 시험 (선택) — dev/checks/backend_check.py 가 실제 로그인까지 시험한다
SUPABASE_CHECK_EMAIL=
SUPABASE_CHECK_PASSWORD=
