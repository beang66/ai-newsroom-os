        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  return {\n    json: {\n      card_id: data.card_id || '',\n      render_status: data.success === true ? 'success' : 'error',\n      rendered_image_url: data.image_url || '',\n      file_name: data.file_name || '',\n      file_path: data.file_path || ''\n    }\n  };\n});;"
