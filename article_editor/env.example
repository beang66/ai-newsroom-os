# 이 파일을 복사해 .env로 이름을 바꾼 뒤, 본인 OpenAI API 키를 입력하세요.
# 키를 입력한 .env는 GitHub에 올리지 마세요.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# 사진 검색을 사용할 때만 Unsplash Access Key를 입력하세요.
# 제목·부제·요약에는 필요하지 않습니다.
UNSPLASH_ACCESS_KEY=

PORT=8765

# 로컬 모델로 초안을 생성한 뒤 OpenAI가 편집합니다.
USE_LOCAL_MODELS=true
# openai: API 요약 / kobart: 로컬 모델 초안과 OpenAI 편집
FLOW_SUMMARY_PROVIDER=kobart

# ONNX 모델 파일을 사용합니다. 최초 실행 전 모델 배치와 패키지 설치가 필요합니다.
LOCAL_MODEL_RUNTIME=onnx
HEADLINE_ONNX_DIR=models/onnx/headline
SUBTITLE_ONNX_DIR=models/onnx/subtitle

# 로그인 연동 전 로컬 저장용 테스트 사용자입니다.
WORKSPACE_USER_ID=test-user-001
