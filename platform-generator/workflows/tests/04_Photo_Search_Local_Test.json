    {
      "parameters": {
        "jsCode": "const photos = $json.results || [];\n\nreturn [{\n  json: {\n    query: $('Photo Search Query').item.json.query,\n\n    results: photos.map(photo => ({\n      photo_id: photo.id || '',\n\n      thumbnail_url:\n        photo.urls?.small || '',\n\n      image_url:\n        photo.urls?.regular || '',\n\n      full_image_url:\n        photo.urls?.full || '',\n\n      width:\n        photo.width || null,\n\n      height:\n        photo.height || null,\n\n      photographer:\n        photo.user?.name || '',\n\n      photographer_profile:\n        photo.user?.links?.html || '',\n\n      source_url:\n        photo.links?.html || '',\n\n      download_location:\n        photo.links?.download_location || '',\n\n      description:\n        photo.description ||\n        photo.alt_description ||\n        '',\n\n      source: 'unsplash'\n    }))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "35614b03-0d5c-47e6-a4cb-15a17c26c9f1",
      "name": "Build Photo Results"
    },
    {
      "parameters": {
        "jsCode": "const results = $json.results || [];\n\nif (results.length === 0) {\n  throw new Error('검색된 사진이 없습니다.');\n}\n\nconst selected = results[0];\n\nreturn [\n  {\n    json: {\n      card_id: 'C2',\n      selected_photo: selected\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "1cd0f3e0-4674-4f1f-8f98-819558fe33c2",
      "name": "Select Photo Test"
    },
    {
      "parameters": {
        "jsCode": "const photo = $json.selected_photo;\n\nreturn [\n  {\n    json: {\n      card_id: $json.card_id,\n\n      template: 'photo_body',\n\n      size: {\n        width: 1080,\n        height: 1350\n      },\n\n      content: {\n        keyword: '대치동 현장 취재',\n        headline: '직접 찾아간 대치동 학원가',\n        body: '작가는 여러 차례 현장을 방문하며 실제 교육 환경을 취재했다.'\n      },\n\n      image: {\n        url: photo.image_url,\n        photographer: photo.photographer,\n        source_url: photo.source_url,\n        download_location: photo.download_location\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        0
      ],
      "id": "9e3cf3a9-9b42-4661-8f74-d65034f3055e",
