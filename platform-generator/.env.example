# 기존 .env를 계속 사용하세요. 이 파일에는 실제 키를 넣지 않습니다.
PORT=3001
# 개발용 편집실에서 팀 Core의 DB 기사를 불러올 주소(Core 실행·로그인 필요)
NEWSROOM_CORE_ORIGIN=http://127.0.0.1:8765
# 개발용 편집실의 Documents 초안 저장이 필요할 때만 1로 설정합니다.
# PLATFORM_LOCAL_STORAGE=1
AI_PROVIDER=openai
GEMINI_API_KEY=
# GEMINI_MODEL은 현재 프로젝트에서 동작 확인한 모델명으로 설정하세요.
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
UNSPLASH_ACCESS_KEY=
# 로그인 브라우저: auto는 Chrome → Edge → Chromium 순으로 설치 여부를 확인합니다.
# 실행 중인 프로필 오류는 다른 브라우저로 우회하지 않습니다. 화면에서도 선택할 수 있습니다.
# NEWSROOM_INSTAGRAM_BROWSER=auto
# NEWSROOM_THREADS_BROWSER=auto
# 선택값: auto, chrome, msedge, chromium (Chromium은 Playwright 설치 필요)
# NEWSROOM_INSTAGRAM_BROWSER=chromium
# NEWSROOM_THREADS_BROWSER=chromium

# 팀 Vite 개발 화면을 프록시로 연결할 때만 실제 Origin을 설정합니다.
# NEWSROOM_EDITOR_ORIGIN=http://localhost:5173
