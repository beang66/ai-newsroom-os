# 이 파일을 복사해 .env로 이름을 바꾸고, = 오른쪽에 키를 입력하세요.
# 키를 입력한 .env는 GitHub에 올리지 마세요.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# 필수: Unsplash 개발자 페이지의 Access Key를 입력하세요.
# 사진 검색·선택에 사용하는 값입니다. Secret Key나 Application ID를 넣지 마세요.
UNSPLASH_ACCESS_KEY=

# 선택: Application ID (앱 식별 번호). 현재 기능에서는 사용하지 않아 비워도 됩니다.
UNSPLASH_APPLICATION_ID=
# 선택: Secret Key. 사용자 계정 OAuth 인증용이며 현재 사진 검색에는 사용하지 않습니다.
# 현재 기능에서는 비워도 됩니다. 브라우저 코드에는 넣지 마세요.
UNSPLASH_SECRET_KEY=

PORT=8765
USE_LOCAL_MODELS=false
# openai: API 요약 / kobart: 로컬 모델 초안과 OpenAI 편집
FLOW_SUMMARY_PROVIDER=openai
